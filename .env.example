# Local development settings. Copy to .env (never commit .env).

# PostgreSQL (docker-compose maps it to host port 5433)
POSTGRES_USER=orisun
POSTGRES_PASSWORD=orisun
POSTGRES_DB=orisun_iwadi
# Admin connection: tests, the user CLI and make db-roles. Apps use the users below.
POSTGRES_DSN=postgresql://orisun:orisun@localhost:5433/orisun_iwadi

# Least-privilege database users, created by make db-roles (see local/db-roles.sql)
ETL_DB_PASSWORD=change-me-etl
API_DB_PASSWORD=change-me-api
ETL_POSTGRES_DSN=postgresql://orisun_etl:change-me-etl@localhost:5433/orisun_iwadi
API_POSTGRES_DSN=postgresql://orisun_api:change-me-api@localhost:5433/orisun_iwadi

# S3-compatible object storage (SeaweedFS locally, real S3 on AWS).
# Keys must match local/seaweedfs-s3.json.
S3_BUCKET=orisun-iwadi-raw
S3_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=orisun
AWS_SECRET_ACCESS_KEY=orisun-local-secret
AWS_DEFAULT_REGION=us-east-1

# API: secret used to sign login tokens. At least 32 characters; generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# AWS deployment (make aws-*): your OncoLake account number and the CLI profile signed in
# to it with `aws login --profile oncolake`. Deploys refuse to run against any other account.
ONCOLAKE_AWS_ACCOUNT_ID=
ONCOLAKE_AWS_PROFILE=oncolake
